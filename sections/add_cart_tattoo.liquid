<style>
  #shopify-section-add_cart_tattoo .last-cart_page,
  #shopify-section-add_cart_tattoo .last-cart_page_flx,
  #shopify-section-add_cart_tattoo .last-cart_page_flx_iner,
  #shopify-section-add_cart_tattoo .last-cart_page_inner,
  #shopify-section-add_cart_tattoo .cmn_right_iner {
    color: #000;
  }

  #shopify-section-add_cart_tattoo .last-cart_page_flx_iner > h2,
  #shopify-section-add_cart_tattoo .cmn_right_iner h2,
  #shopify-section-add_cart_tattoo .cmn_right_iner h3,
  #shopify-section-add_cart_tattoo .cmn_right_iner h5,
  #shopify-section-add_cart_tattoo .cmn_right_iner p,
  #shopify-section-add_cart_tattoo .cmn_right_iner label,
  #shopify-section-add_cart_tattoo .cmn_right_iner .insert_data,
  #shopify-section-add_cart_tattoo .cmn_right_iner .price {
    color: #000;
  }

  #shopify-section-add_cart_tattoo .last-cart_page_flx_iner {
    padding: 32px;
  }

  #shopify-section-add_cart_tattoo .last-cart_page_flx_iner > h2 {
    margin: 20px 0;
  }

  #shopify-section-add_cart_tattoo .last-cart_page_inner {
    gap: 18px;
  }

  #shopify-section-add_cart_tattoo .last-cart_page_inner .cmn.right {
    padding: 28px;
  }

  #shopify-section-add_cart_tattoo .selected_sizes_data {
    row-gap: 14px;
  }

  #shopify-section-add_cart_tattoo span.add_product_to_cart.button {
    min-height: 47px;
    border: 0;
    border-radius: 5px;
    background: #000;
    box-shadow: none;
    color: #fff;
    cursor: pointer;
  }

  #shopify-section-add_cart_tattoo span.add_product_to_cart.button::before,
  #shopify-section-add_cart_tattoo span.add_product_to_cart.button::after {
    display: none;
    content: none;
  }

  #shopify-section-add_cart_tattoo span.add_product_to_cart.button .text_carts {
    color: #fff;
  }
</style>

<div class="last-cart_page" style="display:none;">
<div class="last-cart_page_flx">
  <span class="close">
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path id="Vector" d="M1.64016 0.27L5.50016 4.13L9.34016 0.29C9.42498 0.199717 9.52716 0.127495 9.64058 0.0776622C9.75399 0.0278298 9.87629 0.00141434 10.0002 0C10.2654 0 10.5197 0.105357 10.7073 0.292893C10.8948 0.48043 11.0002 0.734784 11.0002 1C11.0025 1.1226 10.9797 1.24439 10.9333 1.35788C10.8869 1.47138 10.8178 1.57419 10.7302 1.66L6.84016 5.5L10.7302 9.39C10.895 9.55124 10.9916 9.76959 11.0002 10C11.0002 10.2652 10.8948 10.5196 10.7073 10.7071C10.5197 10.8946 10.2654 11 10.0002 11C9.87272 11.0053 9.74557 10.984 9.62678 10.9375C9.508 10.8911 9.40017 10.8204 9.31016 10.73L5.50016 6.87L1.65016 10.72C1.56567 10.8073 1.46473 10.8769 1.35316 10.925C1.2416 10.9731 1.12163 10.9986 1.00016 11C0.734946 11 0.480592 10.8946 0.293056 10.7071C0.10552 10.5196 0.000162707 10.2652 0.000162707 10C-0.00216879 9.8774 0.0205781 9.75561 0.0670076 9.64212C0.113437 9.52862 0.18257 9.42581 0.270163 9.34L4.16016 5.5L0.270163 1.61C0.105348 1.44876 0.00870232 1.23041 0.000162707 1C0.000162707 0.734784 0.10552 0.48043 0.293056 0.292893C0.480592 0.105357 0.734946 0 1.00016 0C1.24016 0.003 1.47016 0.1 1.64016 0.27Z" fill="black"></path>
      </svg>
    </span>
      

  <div class="last-cart_page_flx_iner">
<h2 class="h1">{{ section.settings.heading | default:"Review Order" }}</h2>
  <div class="last-cart_page_inner">

    
<div class="cmn left">
</div>



<div class="cmn right">
  <div class="cmn_right_iner">
<h2 class="h1 maintitle_prd">Butterfly Temporary Tattoo</h2>
<span class='price h2'>$720.00</span>
{% if section.settings.show_shopPay %}
<p>{{ section.settings.shopPay_text | default:"Pay in 4 interest-free installments for orders over <strong>$50.00</strong> with " }}
<span class="shop_pay">

<svg width="68" height="27" viewBox="0 0 68 27" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<g style="mix-blend-mode:darken">
<rect width="68" height="27" fill="url(#pattern444)"/>
</g>
<defs>
<pattern id="pattern444" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_537_11260" transform="scale(0.0147059 0.037037)"/>
</pattern>
<image id="image0_537_11260" width="169" height="27" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
{% if section.settings.shopPay_learnmore_url != blank %}
<a href="{{ section.settings.shopPay_learnmore_url | default:"#" }}">{{ section.settings.shopPay_learnmore | default:"Learn More" }}</a>
{% endif %}
</span>
</p>
{% endif %}
<div class="selected_sizes_data">
  
  <div class="sel_sizes_data">
     <label>Size:</label>
    <br>
    <div class="insert_data">
    6x6 inches
    </div>
  
  </div>

   <div class="sel_qty_data">
     <label>Quantity:</label>
     <br>
    <div class="insert_data">
    1 Tattoo
    </div>
  </div>

     <div class="sel_tattoo_finish_data">
     <label>Tattoo Finish:</label>
       <br>
    <div class="insert_data">
     Classic
    </div>
  </div>

  <h3><b>Design notes: </b></h3>
  <h5>Example - For 100+ Classic Tattoos White Ink Placement location </h5>
  <div class="inner_Content_row">
      <textarea type="text" class="cartnote_field"></textarea>
    </div>
</div>
  <span class='add_product_to_cart button '>
   <span class="text_carts">
<svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
