</svg>
 {{ section.settings.atc_button | default:"ADD TO CART" }}</span>

{% if section.settings.cstm_loder != blank %}
<div class="cstm_loder"><img src="{{ section.settings.cstm_loder | image_url: width: 64 }}" alt="{{ section.settings.cstm_loder.alt }}" width="32" height="32"></div>
{% else %}
  <div class="cstm_loder"><img src="{{ 'ZKZx.webp' | file_url }}" alt="cstm_loder" width="32" height="32"></div>

{% endif %}

  </span> 
</div>
</div>
</div>
  </div>
</div>
</div>

{% schema %}
  {
    "name": "ADD TO CART Popup",
    "settings": [
    {
      "type": "image_picker",
      "id": "cstm_loder",
      "label": "Custom Loader"
    }, 
        {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }, 
      {
      "type": "checkbox",
      "id": "show_shopPay",
      "label": "Show Shop Pay",
      "default":true
    },
      {
      "type": "richtext",
      "id": "shopPay_text",
      "label": "Shop Pay Text"
    },
       {
      "type": "text",
      "id": "shopPay_learnmore",
      "label": "Shop Pay Learn More"
    },
      {
      "type": "url",
      "id": "shopPay_learnmore_url",
      "label": "Shop Pay Learn More URL"
    },
      {
      "type": "text",
      "id": "atc_button",
      "label": "Cart Button Text"
    }
      
    ]
  }
{% endschema %}