<style>
  .template_Tattoo-page .instructions_popup .instructions_popup_inner,
  .template_Tattoo-page .instructions_popup .instructions_iner,
  [id*="instruction-popup"] .instructions_popup_inner,
  [id*="instruction-popup"] .instructions_iner {
    color: #000;
  }

  .template_Tattoo-page .instructions_popup .instructions_iner h1,
  .template_Tattoo-page .instructions_popup .instructions_iner h2,
  .template_Tattoo-page .instructions_popup .instructions_iner h3,
  .template_Tattoo-page .instructions_popup .instructions_iner h4,
  .template_Tattoo-page .instructions_popup .instructions_iner h5,
  .template_Tattoo-page .instructions_popup .instructions_iner h6,
  .template_Tattoo-page .instructions_popup .instructions_iner p,
  .template_Tattoo-page .instructions_popup .instructions_iner li,
  .template_Tattoo-page .instructions_popup .instructions_iner span,
  .template_Tattoo-page .instructions_popup .instructions_iner strong,
  .template_Tattoo-page .instructions_popup .instructions_iner em,
  .template_Tattoo-page .instructions_popup .instructions_iner div,
  .template_Tattoo-page .instructions_popup .instructions_iner td,
  .template_Tattoo-page .instructions_popup .instructions_iner th,
  .template_Tattoo-page .instructions_popup .instructions_iner label,
  [id*="instruction-popup"] .instructions_iner h1,
  [id*="instruction-popup"] .instructions_iner h2,
  [id*="instruction-popup"] .instructions_iner h3,
  [id*="instruction-popup"] .instructions_iner h4,
  [id*="instruction-popup"] .instructions_iner h5,
  [id*="instruction-popup"] .instructions_iner h6,
  [id*="instruction-popup"] .instructions_iner p,
  [id*="instruction-popup"] .instructions_iner li,
  [id*="instruction-popup"] .instructions_iner span,
  [id*="instruction-popup"] .instructions_iner strong,
  [id*="instruction-popup"] .instructions_iner em,
  [id*="instruction-popup"] .instructions_iner div,
  [id*="instruction-popup"] .instructions_iner td,
  [id*="instruction-popup"] .instructions_iner th,
  [id*="instruction-popup"] .instructions_iner label {
    color: #000;
  }

  .template_Tattoo-page .instructions_popup .instructions_iner a,
  [id*="instruction-popup"] .instructions_iner a {
    color: #0645ad;
    text-decoration: underline;
  }
</style>

  <div class="instructions_popup">
    <div class="instructions_popup_inner">
      <span class="close">
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path id="Vector" d="M1.64016 0.27L5.50016 4.13L9.34016 0.29C9.42498 0.199717 9.52716 0.127495 9.64058 0.0776622C9.75399 0.0278298 9.87629 0.00141434 10.0002 0C10.2654 0 10.5197 0.105357 10.7073 0.292893C10.8948 0.48043 11.0002 0.734784 11.0002 1C11.0025 1.1226 10.9797 1.24439 10.9333 1.35788C10.8869 1.47138 10.8178 1.57419 10.7302 1.66L6.84016 5.5L10.7302 9.39C10.895 9.55124 10.9916 9.76959 11.0002 10C11.0002 10.2652 10.8948 10.5196 10.7073 10.7071C10.5197 10.8946 10.2654 11 10.0002 11C9.87272 11.0053 9.74557 10.984 9.62678 10.9375C9.508 10.8911 9.40017 10.8204 9.31016 10.73L5.50016 6.87L1.65016 10.72C1.56567 10.8073 1.46473 10.8769 1.35316 10.925C1.2416 10.9731 1.12163 10.9986 1.00016 11C0.734946 11 0.480592 10.8946 0.293056 10.7071C0.10552 10.5196 0.000162707 10.2652 0.000162707 10C-0.00216879 9.8774 0.0205781 9.75561 0.0670076 9.64212C0.113437 9.52862 0.18257 9.42581 0.270163 9.34L4.16016 5.5L0.270163 1.61C0.105348 1.44876 0.00870232 1.23041 0.000162707 1C0.000162707 0.734784 0.10552 0.48043 0.293056 0.292893C0.480592 0.105357 0.734946 0 1.00016 0C1.24016 0.003 1.47016 0.1 1.64016 0.27Z" fill="black"/>
        </svg>
      </span>

      <div class="aa instructions_iner">
      
        {% if section.settings.show_pagecontent %}
           {{ page.content }} 
        {% elsif section.settings.link != blank %}
              <iframe src="https://docs.google.com/gview?url={{ section.settings.link }}&embedded=true" style="width:100%; height:500px;" frameborder="0"></iframe>

        {% else %}
        {{ section.settings.content }} 
        {% endif %}

      </div>
            
            
    </div>
  </div>
{% schema %}
{
  "name": "instruction-popup",
  "class": "popup_comon",
  "settings": [
    {
        "type": "checkbox",
        "id": "show_pagecontent",
        "default": true,
      "label": "Show Page Content",
       "info": "Enable this to only show Tatto page Content. Change the content form the page's descritption."
      },
     {
        "type": "textarea",
        "id": "content",
        "label": "Content"
      },{
        "type": "url",
        "id": "link",
        "label": "iframe File Link",
       "info": "assign any pdf link, to show the instruction within an iframe"
      }

  ],

"presets": [
  {
    "name": "instruction-popup"
  }
]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}

