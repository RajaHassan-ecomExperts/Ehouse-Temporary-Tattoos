<style>
  .tatoo_hamb .hamburger {
      height: 4.4rem;
      width: 4.4rem;
      padding: 0px;
      display: flex;
      align-items: center;
      justify-content: center;
  }
  .tatoo_hamb .hamburger svg.icon {
      display: block;
      position: absolute;
      width: auto;
      height: auto;
      opacity: 1;
      transform: scale(1);
      transition: transform .15s ease,opacity .15s ease;

      fill: none;
      vertical-align: middle;
  }
  .tatoo_hamb .hamburger.open-menu .icon-hamburger {
      visibility: hidden;
      opacity: 0;
      transform: scale(.8);
  }
  .tatoo_hamb .hamburger .icon-close {
      visibility: hidden;
      opacity: 0;
      transform: scale(.8);
  }
  .tatoo_hamb .hamburger.open-menu .icon-close {
      display: block;
      position: absolute;
      width: auto;
      height: auto;
      opacity: 1;
      transform: scale(1);
      transition: transform .15s ease,opacity .15s ease;
      fill: none;
      vertical-align: middle;
      visibility: visible;
  }
</style>
<div class="header_tattoo sss">
  <div class="header_tattoo_inner">
    <div class="tatoo_hamb">
      <div class="hamburger">
        {% render 'tattoo-icon-hamburger' %}
        {% render 'tattoo-icon-close' %}
      </div>
    </div>
    <div class="logo_tattoo">
      <a href="{{ shop.url }}"
        ><img
          src="{{ section.settings.logo | img_url:'master' }}"
          height=""
          width=""
          loading="lazy"
          alt="{{ section.settings.logo.alt }}"
      ></a>
    </div>
    <div class="tatoo_nav small-hide">
      <ul style="display:none;">
    {% if section.settings.frst_opt != blank %}
        <li class="file_file h4" id="file_data">
          {{ section.settings.frst_opt }}
          <svg
            fill="#000000"
            height="13px"
            width="13px"
            version="1.1"
            id="Layer_1"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
