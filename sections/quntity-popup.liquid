    {% comment %}           
{% for info in page.metafields.custom.prddata.value %}
 <h4 class="product-detail-heading">{{ info.name }}</h4>
 <p>{{ info.height.title }} - {{ info.height.value }}</p>
 <p>{{ info.diameter.title }} - {{ info.diameter.value }}</p>
{% endfor %}
    {% endcomment %}      
    <div class="pop_item" id="quantity">
      <h2>{{ section.settings.heading | default:"Quantity"}}</h2>
      <h5>{{ section.settings.sub_heading | default:"Please Select a Tattoos Quantity!"}}</h5>

  <div class='qty_box_custom'>
      <select name="quantity-select" class='qty_selected_row sel_qty' id="qty-classic">
        {% comment %} {% assign qty_option = section.settings.qty_option1 | newline_to_br | split: '<br />' %}
            {% for item in qty_option  %}
         
            {% assign optionname = item | strip   %}
                <option value="{{ optionname }}">{{ optionname }}</option>
              {% endfor %} 
          {% endcomment %}
      </select>

       <select name="quantity-select" class='qty_selected_row' id="qty-gliter" style="display:none;"> 
         {%comment %} {% assign qty_option = section.settings.qty_option2 | newline_to_br | split: '<br />' %}
            {% for item in qty_option  %}
         
            {% assign optionname = item | strip   %}
                <option value="{{ optionname }}">{{ optionname }}</option>
              {% endfor %} 
           {% endcomment %}  
              
      </select>

  
      <select name="quantity-select" class='qty_selected_row' id="qty-metalic" style="display:none;">
       {% comment %}  {% assign qty_option = section.settings.qty_option3 | newline_to_br | split: '<br />' %}
            {% for item in qty_option  %}
         
            {% assign optionname = item | strip   %}
                <option value="{{ optionname }}">{{ optionname }}</option>
              {% endfor %} 
         {% endcomment %}     
      </select>

    <select name="quantity-select" class='qty_selected_row' id="qty-glow" style="display:none;">
      {% comment %} {% assign qty_option = section.settings.qty_option4 | newline_to_br | split: '<br />' %}
            {% for item in qty_option  %}
         
            {% assign optionname = item | strip   %}
                <option value="{{ optionname }}">{{ optionname }}</option>
              {% endfor %} 
         {% endcomment %}   
              
      </select>

      <select name="quantity-select" class='qty_selected_row' id="qty-semi-permanent" style="display:none;">
        {% comment %}  %}  {% assign qty_option = section.settings.qty_option5 | newline_to_br | split: '<br />' %}
            {% for item in qty_option  %}
         
            {% assign optionname = item | strip   %}
                <option value="{{ optionname }}">{{ optionname }}</option>
              {% endfor %} 
           {% endcomment %}   
         </select>
</div>
      <span class='qty_nxt'>Next</span>
