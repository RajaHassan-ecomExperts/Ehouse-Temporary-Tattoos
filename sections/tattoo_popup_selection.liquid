<style>
  #shopify-section-tattoo_popup_selection .tattoo-effect-heading {
    display: block;
    margin: 0;
    color: #000;
    font-family: Roboto, sans-serif;
    font-size: 24px;
    font-weight: 500;
    line-height: normal;
    text-align: center;
    text-transform: none;
    letter-spacing: normal;
  }

  #shopify-section-tattoo_popup_selection .tattoo-effect-production-button {
    display: block;
    width: 100%;
    max-width: 380px;
    min-height: 0;
    margin: 20px auto;
    padding: 10px 24px;
    border: 0;
    border-radius: 999px;
    background: #484848;
    box-shadow: none;
    color: #fff;
    font-family: Roboto, sans-serif;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: normal;
  }

  #shopify-section-tattoo_popup_selection .tattoo-effect-production-button::before,
  #shopify-section-tattoo_popup_selection .tattoo-effect-production-button::after {
    display: none;
    content: none;
  }
</style>

<div class="tattoo_popup popup_selection">
  <div class="tattoo_popup_inner">
    <span class="close">
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path id="Vector" d="M1.64016 0.27L5.50016 4.13L9.34016 0.29C9.42498 0.199717 9.52716 0.127495 9.64058 0.0776622C9.75399 0.0278298 9.87629 0.00141434 10.0002 0C10.2654 0 10.5197 0.105357 10.7073 0.292893C10.8948 0.48043 11.0002 0.734784 11.0002 1C11.0025 1.1226 10.9797 1.24439 10.9333 1.35788C10.8869 1.47138 10.8178 1.57419 10.7302 1.66L6.84016 5.5L10.7302 9.39C10.895 9.55124 10.9916 9.76959 11.0002 10C11.0002 10.2652 10.8948 10.5196 10.7073 10.7071C10.5197 10.8946 10.2654 11 10.0002 11C9.87272 11.0053 9.74557 10.984 9.62678 10.9375C9.508 10.8911 9.40017 10.8204 9.31016 10.73L5.50016 6.87L1.65016 10.72C1.56567 10.8073 1.46473 10.8769 1.35316 10.925C1.2416 10.9731 1.12163 10.9986 1.00016 11C0.734946 11 0.480592 10.8946 0.293056 10.7071C0.10552 10.5196 0.000162707 10.2652 0.000162707 10C-0.00216879 9.8774 0.0205781 9.75561 0.0670076 9.64212C0.113437 9.52862 0.18257 9.42581 0.270163 9.34L4.16016 5.5L0.270163 1.61C0.105348 1.44876 0.00870232 1.23041 0.000162707 1C0.000162707 0.734784 0.10552 0.48043 0.293056 0.292893C0.480592 0.105357 0.734946 0 1.00016 0C1.24016 0.003 1.47016 0.1 1.64016 0.27Z" fill="black"/>
      </svg>
    </span>
    <h2 class="tattoo-effect-heading">{{ section.settings.Heading | default: 'Choose Your Tattoo Effect' }}</h2>
    {% if section.settings.sub_Heading != blank %}
    <h5>{{ section.settings.sub_Heading }}</h5>
      {% endif %}

    {% assign production_button_link = section.settings.button_link | default: '/pages/production-time' %}
    {% assign production_button_text = section.settings.button_text | default: 'View Production Times' %}
    {% if production_button_link != blank %}
    <a href="{{ production_button_link }}" target="blank" class="button tattoo-effect-production-button">
{{ production_button_text }}
  </a>
  {% endif %}

    {% assign custom_product1 = all_products[section.settings.product1] %}
    {% assign custom_product2 = all_products[section.settings.product2] %}
    {% assign custom_product3 = all_products[section.settings.product3] %}
    {% assign custom_product4 = all_products[section.settings.product4] %}
    {% assign custom_product5 = all_products[section.settings.product5] %}

    <div class="inner_Content_row">
      <div class="loop-all selection_active" custom_product="{{ custom_product1.handle }}" id="qty-classic">
        <div class="loop">
          <img
            src="{{ custom_product1 | img_url: "medium" }}"
            alt="{{ custom_product1.featured_image.alt }}"
            class="custom_load"
            height=""
            width=""
            loading="lazy"
          >
        </div>
        <div class="loop-data">
          <span>{{ custom_product1.title }}</span>
          {% if section.settings.product1_txt != blank %}
            <p>( {{ section.settings.product1_txt }} )</p>
          {% endif %}
        </div>
      </div>

      <div class="loop-all" custom_product="{{ custom_product2.handle }}" id="qty-semi-permanent">
        <div class="loop">
          <img
            src="{{ custom_product2 | img_url: "medium" }}"
            alt="{{ custom_product2.featured_image.alt }}"
            class="custom_load"
            height=""
            width=""
            loading="lazy"
          >
        </div>
        <div class="loop-data">
          <span>{{ custom_product2.title }}</span>
          {% if section.settings.product2_txt != blank %}
            <p>( {{ section.settings.product2_txt }} )</p>
          {% endif %}
        </div>
      </div>

      {% comment %} Update: 05/21/26 Glitter option no longer needed, uncomment this below div if you require glitter option back{% endcomment %}
      {% comment %} <div class="loop-all" custom_product="{{ custom_product3.handle }}" id="qty-gliter" opval="ophide">
        <div class="loop">
          <img
            src="{{ custom_product3 | img_url: "medium" }}"
            alt="{{ custom_product3.featured_image.alt }}"
            class="custom_load"
            height=""
            width=""
            loading="lazy"
          >
        </div>
        <div class="loop-data">
          <span>{{ custom_product3.title }}</span>
          {% if section.settings.product3_txt != blank %}
            <p>( {{ section.settings.product3_txt }} )</p>
          {% endif %}
        </div>
      </div> {% endcomment %}

      <div class="loop-all" custom_product="{{ custom_product4.handle }}" id="qty-metalic" opval="ophide">
        <div class="loop">
          <img
            src="{{ custom_product4 | img_url: "medium" }}"
            alt="{{ custom_product4.featured_image.alt }}"
            class="testt custom_load"
            height=""
            width=""
            loading="lazy"
          >
        </div>
        <div class="loop-data">
          <span>{{ custom_product4.title }}</span>
          {% if section.settings.product4_txt != blank %}
            <p>( {{ section.settings.product4_txt }} )</p>
          {% endif %}
        </div>
      </div>

      <div class="loop-all" custom_product="{{ custom_product5.handle }}" id="qty-glow" opval="ophide">
        <div class="loop">
          <img
            src="{{ custom_product5 | img_url: "medium" }}"
            alt="{{ custom_product5.featured_image.alt }}"
            class="custom_load"
            height=""
            width=""
            loading="lazy"
          >
        </div>
        <div class="loop-data">
          <span>{{ custom_product5.title }}</span>
          {% if section.settings.product5_txt != blank %}
            <p>( {{ section.settings.product5_txt }} )</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

