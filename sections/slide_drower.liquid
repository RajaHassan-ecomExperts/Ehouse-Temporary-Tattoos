<div id="wrapper">
  <div class="card">
    <div class="drower_search">
      <form class="search-box" id="live-search" action="" method="post">
        <button>
          <span class="">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g id="Group 5">
              <path id="Vector" d="M14.1147 11.9812H13.2544L12.9495 11.6871C13.6301 10.8964 14.1275 9.96508 14.4061 8.95971C14.6848 7.95434 14.7377 6.8998 14.5613 5.87157C14.0494 2.844 11.5228 0.426299 8.47344 0.0560206C7.4014 -0.079604 6.31253 0.0318127 5.29017 0.381745C4.2678 0.731677 3.33904 1.31085 2.57494 2.07494C1.81085 2.83904 1.23168 3.7678 0.881745 4.79017C0.531813 5.81253 0.420396 6.9014 0.556021 7.97344C0.926299 11.0228 3.344 13.5494 6.37157 14.0613C7.3998 14.2377 8.45434 14.1848 9.45971 13.9061C10.4651 13.6275 11.3964 13.1301 12.1871 12.4495L12.4812 12.7544V13.6147L14.9315 16.0651C15.378 16.5116 16.1077 16.5116 16.5542 16.0651C17.0007 15.6186 17.0007 14.8889 16.5542 14.4424L14.1147 11.9812ZM7.58042 11.9812C4.86867 11.9812 2.67968 9.79216 2.67968 7.08042C2.67968 4.36867 4.86867 2.17968 7.58042 2.17968C10.2922 2.17968 12.4812 4.36867 12.4812 7.08042C12.4812 9.79216 10.2922 11.9812 7.58042 11.9812Z" fill="#252627"/>
              </g>
            </svg>
          </span>
        </button>
        <input
          type="text"
          class="text-input"
          name="focus"
          placeholder="Search..."
          id="filter-search"
          value=""
        >

        <span class="btn_close">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path id="Vector" opacity="0.22" d="M1.49095 0.245437L4.99979 3.75428L8.49045 0.263617C8.56755 0.181548 8.66044 0.115896 8.76353 0.0705969C8.86662 0.025298 8.9778 0.00128568 9.0904 0C9.33149 0 9.56271 0.095772 9.73318 0.266247C9.90366 0.436723 9.99943 0.667937 9.99943 0.909026C10.0015 1.02047 9.98087 1.13118 9.93867 1.23435C9.89646 1.33752 9.83362 1.43097 9.75399 1.50898L6.21788 4.99964L9.75399 8.53575C9.90381 8.68232 9.99167 8.88081 9.99943 9.09026C9.99943 9.33134 9.90366 9.56256 9.73318 9.73303C9.56271 9.90351 9.33149 9.99928 9.0904 9.99928C8.97455 10.0041 8.85897 9.98475 8.75099 9.9425C8.64301 9.90025 8.545 9.836 8.46318 9.75384L4.99979 6.24501L1.50004 9.74475C1.42323 9.82409 1.33147 9.88742 1.23006 9.93111C1.12865 9.97479 1.01959 9.99796 0.909173 9.99928C0.668085 9.99928 0.436871 9.90351 0.266395 9.73303C0.0959199 9.56256 0.000147905 9.33134 0.000147905 9.09026C-0.00197148 8.97881 0.018706 8.8681 0.0609117 8.76493C0.103117 8.66176 0.165961 8.56831 0.245585 8.4903L3.78169 4.99964L0.245585 1.46353C0.0957637 1.31696 0.00791063 1.11848 0.000147905 0.909026C0.000147905 0.667937 0.0959199 0.436723 0.266395 0.266247C0.436871 0.095772 0.668085 0 0.909173 0C1.12734 0.00272708 1.33642 0.0909025 1.49095 0.245437Z" fill="black"/>
          </svg>
        </span>
      </form>
      <p id="no-count"></p>
    </div>
    <div class="open_content imgs_div" id="design">
      <div class="tabs">
        <ul id="tabs-nav" class="slid_des">
		{%- for block in section.blocks -%}
		 <li><a href="#tab{{forloop.index}}" >{{ block.settings.heading }}</a></li>
		  {% endfor %}
        </ul>
        <div id="tabs-content" class="slid_des_content">
          <span class="content-back-arrow" style="display:none;">{% render 'back-arrow' %}Back</span>
		{%- for block in section.blocks -%}
		 
			<div id="tab{{forloop.index}}" class="tab-content">
				<span style="display:none;">{{ block.settings.heading }}</span>
				<div class="design_content get_imgs" style="display:none;" >

					{% assign svgPrefix1 = block.settings.prefix_image %}
					{% assign limit1 = block.settings.limit %}

					{% assign numberOfSVGs1 = limit1 %}

					{% for i in (1..numberOfSVGs1) %}

					{% assign svgName = svgPrefix1 | append: i | append: ".svg" %}
					<div class="svg_item imgs" {{ svgPrefix1 }}>
						<span data-src="{{ svgName | file_url }}" alt="{{ svgName.alt }}"   style="display:none;"></span>
					</div>
				{% endfor %}
				</div>

				<div class="design_content_dynamic" limits_data="{{ numberOfSVGs1 }}">
				</div>

			</div>
		 
		  {% endfor %}
		
		
          
        
        </div>

 
      </div>
    </div>
    <div class="open_content upload_content" id="upload">


      <form id="uploadForm" name="uploadForm" action="" enctype="multipart/form-data" method="post">
      <div class="upload_input_wrap">
      <label for="imageInput">
        <input type="file" id="imageInput" multiple hidden>
        <div class="btn-up" id="dropZone_tatto">
          <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17 33C8.16345 33 1 25.8366 1 17C1 8.16345 8.16345 1 17 1" stroke="white" stroke-width="2" stroke-linecap="round"/></path>
            <path d="M17 1C25.8366 1 33 8.16345 33 17C33 25.8366 25.8366 33 17 33" stroke="white" stroke-width="2" stroke-linecap="round"/></path>
            <path d="M17 24.1112V10.7778" stroke="white" stroke-width="2" stroke-linecap="round"/></path>
            <path d="M23.2218 17.0001L16.9996 10.7778L10.7773 17.0001" stroke="white" stroke-width="2" stroke-linecap="round"/></path>
          </svg>

          <div class="content_part">
            <strong>{{  section.settings.drag_drop_title | default:'Drag and drop or choose a file to upload.' }}</strong>
            <p>{{  section.settings.drag_drop_info | default:'Upload PNG,JPG file. We require images to be 300dpi for printing.' }}</p>
          </div>
        </div>
      </label>
          
      <h3>{{  section.settings.uploaded_file_heading | default:'Your Uploads' }}</h3>
      <p>{{  section.settings.uploaded_file_info | default:'Upload an image to get started!' }}</p>
        <span class='bg_done_img' style='display:none;'><img src=""> </span>
      </div>
      <div class="uploades_imgs_data imgs_div"></div>
        <div class="uploades_imgs_data_back imgs_div" style="display:none;"></div>
    </div>
    
      </form> 
    <div class="open_content text_content" id="text">
       <h3>All results</h3>
       <div class="fonts_load static_fonts" style="display:none;">
         {% for link in linklists[settings.tatto_fonts].links %}
           <div class="dnt-item" value="{{ link.title }}" ><span value="{% if link.title == 'Playwrite USA Traditional' %}Playwrite US Trad{% elsif link.title == 'Playwrite USA Modern' %}Playwrite US Modern{%else %}{{ link.title }}{% endif %}" style="font-family: {% if link.title == 'Playwrite USA Traditional' %}Playwrite US Trad{% elsif link.title == 'Playwrite USA Modern' %}Playwrite US Modern{%else %}{{ link.title }}{% endif %};">Ag</span><p>{{ link.title }}</p></div>
         {% endfor %}
       </div>      
       <div id="font-family" class="fonts_load dynamic_loads_fonts" data_fonts="{{ section.settings.fnts1 }}"></div>    
    </div> 


              
  </div>


              
</div>

{% schema %}
{
  "name": "Slide Drawer",
  "settings": [
  {
        "type": "header",
        "content": "Upload Options"
      },
       {
            "type": "text",
            "id": "drag_drop_title",
             "label": "Drag Drop Heading"
          },     {
            "type": "html",
            "id": "drag_drop_info",
            "label": "Drag Drop Info"
          }, {
            "type": "text",
            "id": "uploaded_file_heading",
            "label": "Uploaded File Heading"
          },  {
            "type": "html",
            "id": "uploaded_file_info",
            "label": "Uploaded File Info"
          }
 ],
  "blocks": [
    {
      "type": "tattoo_design",
      "name": "Tattoo design items",
      "settings": [
        
        {
          "type": "range",
          "id": "limit",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "itm",
          "label": "Total Clipart Images",
          "default": 6
        },
          {
            "type": "text",
            "id": "heading",
            "label": "Design Tab Heading"
          },
          {
            "type": "text",
            "id": "prefix_image",
            "label": "Design Image Prefix"
          }
         ]
    }
  ]
  
}
{% endschema %}