    {%- endfor -%} 
  
    {%- endfor -%}
</div>



  <div class="variants_data" style="display:none;" custom_product="{{ custom_product4.handle }}"  data-sku="{{ section.settings.sku4 }}"  custom_product_title="{{ custom_product4.title }}">
   {% for option in custom_product4.options_with_values %}
           {% for value in option.values %}
