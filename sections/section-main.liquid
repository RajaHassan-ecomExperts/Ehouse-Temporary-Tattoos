    {%- endfor -%} 
  
    {%- endfor -%}
</div>

  
</div>

{% capture variant_prices %}
{% for variant in custom_product1.variants %}
  {% if variant.title == "6.0 x 6.0" %}{{ variant.price }}{% endif %}
{% endfor %}
{% endcapture %}

{% capture variant_id %}{% for variant in custom_product1.variants %}{% if variant.title == "6.0 x 6.0" %}{{ variant.id }}{% endif %}{% endfor %}{% endcapture %}



<form
  class="form_syn" sym="{{ cart.currency.symbol }}"
  data_title="{{ custom_product1.title }}"
  data_price_product="{{ variant_prices | money_without_currency}}"
  data_price_product_with_symbol="{{ variant_prices | money_without_currency  }}"
>
 <input type="hidden" name="properties[Size:]" class="size_selected" value="6x6 inches">
  <input type="hidden" name="properties[Tattoo Finish:]" class="tatoo_finsih_selected" value="Classic Custom">
  <input type="hidden" name="properties[White Option:]" class="white_option_selected">
  <input type="hidden" name="properties[Notes:]" class="nots_selected">
   <input type="hidden" name="properties[Sku:]" class="prd__sku">
  <input type="hidden" class="back_tatoo" name="properties[Back Tattoo:]">
  <input type="hidden" class="quantity_selected" name="quantity" value="1">
    <input type="hidden" class="price_selected" name="price" value="{{ variant_prices | money_without_currency }}">
     <input type="hidden" class="actual_price" name="actualprice" value="{{ variant_prices | money_without_currency  }}">
  <input type="hidden" class='custom_varinat_id' name="id" value="{{variant_id }}">
</form>
