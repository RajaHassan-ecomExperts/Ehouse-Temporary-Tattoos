{% assign custom_product1 = all_products[section.settings.product1] %}
{% assign custom_product2 = all_products[section.settings.product2] %}
{% assign custom_product3 = all_products[section.settings.product3] %}
{% assign custom_product4 = all_products[section.settings.product4] %}
{% assign custom_product5 = all_products[section.settings.product5] %}
<div class="variants_div">
<div class="variants_data" style="display:none;" custom_product="{{ custom_product1.handle }}"  data-sku="{{ section.settings.sku1 }}"  custom_product_title="{{ custom_product1.title }}">

    {% for option in custom_product1.options_with_values %}
           {% for value in option.values %}
    {% assign variant = custom_product1.variants | where: 'title', value | first %}
    <span size="{{ value }}" id="{{ variant.id }}" price="{{  variant.price | money_without_currency | remove: ".00" }}" data-price="{{  variant.price | money_without_currency | remove: ".00" }}"></span> 
    {%- endfor -%} 
  
    {%- endfor -%}


</div>

<div class="variants_data" style="display:none;" custom_product="{{ custom_product2.handle }}"  data-sku="{{ section.settings.sku2 }}"  custom_product_title="{{ custom_product2.title }}">
