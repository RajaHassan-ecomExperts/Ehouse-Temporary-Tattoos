    </span>
    <div class="inner_Content_row">
      {% if section.settings.heading != blank %} <h2>{{ section.settings.heading }}</h2>{% endif %}
  {% if section.settings.description != blank or section.settings.description2 != blank  %}
      <h3 class="rte description">
        {{ section.settings.description }} 
    </h3>
      {% endif %}
      
      <div class="popup_back_btn">
        <span class="cstm-btn cstm-primary-btn active" data-text="Yes">{{ section.settings.first_btn_label }}</span>
        <span class="cstm-btn cstm-secondary-btn" data-text="No">{{ section.settings.scnd_btn_label }}</span>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Tattoo Popup Back",
  "class": "popup_comon",
  "settings": [
     {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "html",
        "id": "description",
        "label": "Description",
        "info":"Use <span></span> tag for red text"
      },
      {
        "type": "text",
        "id": "first_btn_label",
        "label": "Button Label"
      },
      {
        "type": "text",
        "id": "scnd_btn_label",
        "label": "Button Label"
      }

  ],
"presets": [
  {
    "name": "Tattoo Popup Back"
  }
]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

