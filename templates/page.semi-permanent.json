NITY™ Semi-Permanent tattoo adventure. Keep the creativity rolling!<\/p>","page":"","button_text_size":"t3","button_label_1":"","button_link_1":"\/","button_style_1":"primary","button_style_1_show_arrow":false,"button_style_1_show_gradient_border":false,"button_1_border_gradient":"linear-gradient(136deg, rgba(10, 234, 237, 1) 11%, rgba(250, 13, 253, 1) 84%)"}}},"block_order":["collapsible_row_Nc9HDh","collapsible_row_VnA7w8","collapsible_row_9iDDkV","collapsible_row_mH3rYD"],"disabled":true,"name":"Image with collapsed rows","settings":{"show_line_separator":false,"row_heading_size":"t1","row_text_size":"t3","image_overlay_opacity":0,"desktop_section_height":480,"mobile_section_height":280,"desktop_media_width":40,"layout":"media_first","content_layout":"no-overlap-separate","show_header_beside":false,"content_max_width":"m","desktop_heading_alignment":"left","mobile_heading_alignment":"left","desktop_content_position":"md:justify-start md:items-end","mobile_content_position":"justify-center items-center","title":"HOW IT WORKS","italic_convert":"","heading_size":"h2","text":"","text_size":"t3","button_label":"","button_link":"","button_style":"secondary","button_text_size":"t5","button_style_show_arrow":true,"button_style_show_gradient_border":false,"button_border_gradient":"linear-gradient(136deg, rgba(10, 234, 237, 1) 11%, rgba(250, 13, 253, 1) 84%)","section_color_scheme":"scheme-a10405d6-8fc1-4bbc-98cf-302b3f2e28b8","color_scheme":"scheme-9f50db5c-3a8f-443d-96dd-b3670cac1ef2","image_overlay_color_scheme":"scheme-9f50db5c-3a8f-443d-96dd-b3670cac1ef2","show_content_shadow":true,"line_separator":"","top_padding":"pt-s","bottom_padding":"pb-s","heading_tag":"h3","visibility":"","hide_when_empty":false,"show_at_specific_time_of_day":false,"show_time_morning":true,"show_time_afternoon":true,"show_time_evening":true,"show_time_night":true}},"collapsible_content_GMbrDw":{"type":"collapsible-content","blocks":{"collapsible_row_xPjNmt":{"type":"collapsible_row","settings":{"row_open":true,"heading":"How long do semi-permanent temporary tattoos last?","icon":"","image_width":20,"row_heading_tag":"h3","row_content":"<p>Our semi-permanent temporary tattoos typically last for up to 2 weeks, depending on factors such as skin type, placement, and care. They gradually fade over time.<\/p>","page":"","content_embed":"","button_text_size":"t3","button_label_1":"","button_link_1":"\/","button_style_1":"primary","button_style_1_show_arrow":false,"button_style_1_show_gradient_border":false,"button_1_border_gradient":"linear-gradient(136deg, rgba(10, 234, 237, 1) 11%, rgba(250, 13, 253, 1) 84%)"}},"collapsible_row_NiDBNF":{"type":"collapsible_row","settings":{"row_open":false,"heading":"Are semi-permanent tattoos safe for all skin types?","icon":"","image_width":20,"row_heading_tag":"h3","row_content":"<p>Yes, our semi-permanent temporary tattoos are safe for all skin types. Our proprietary formulation is plant based and skin-safe.<\/p>","page":"","content_embed":"","button_text_size":"t3","button_label_1":"","button_link_1":"\/","button_style_1":"primary","button_style_1_show_arrow":false,"button_style_1_show_gradient_border":false,"button_1_border_gradient":"linear-gradient(136deg, rgba(10, 234, 237, 1) 11%, rgba(250, 13, 253, 1) 84%)"}},"collapsible_row_NV6T3T":{"type":"collapsible_row","settings":{"row_open":false,"heading":"Can I swim or shower with a semi-permanent temporary tattoo?","icon":"","image_width":20,"row_heading_tag":"h3","row_content":"<p>Yes, you can engage in regular activities such as swimming and showering with semi-permanent tattoos. However, extended exposure to water or harsh soaps may shorten their lifespan. Patting the tattoo dry instead of rubbing can help maintain its longevity.<\/p>","page":"","content_embed":"","button_text_size":"t3","button_label_1":"","button_link_1":"\/","button_style_1":"primary","button_style_1_show_arrow":false,"button_style_1_show_gradient_border":false,"button_1_border_gradient":"linear-gr